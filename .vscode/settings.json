{
  // 에디터도 프로젝트에 설치된 TypeScript를 쓴다.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // 포맷은 oxfmt, 린트 자동 수정은 oxlint (oxc 확장)
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },

  // Tailwind v4는 CSS 진입점을 지정해야 tide 토큰 class까지 자동완성된다.
  "tailwindCSS.experimental.configFile": "src/app/globals.css",
  "tailwindCSS.classFunctions": ["cn", "clsx", "twMerge"]
}
