{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/coverage/**",
    "**/dist/**",
    "**/out/**",
    "apps/tide-site/public/assets/**",
    "next-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/**"],
                "message": "packages는 앱의 @/ alias를 import하지 않는다(.claude/rules/fe-monorepo-structure.md 9번)."
              },
              {
                "group": [
                  "tide-dashboard",
                  "tide-dashboard/*",
                  "tide-site",
                  "tide-site/*",
                  "**/apps/**"
                ],
                "message": "packages는 앱을 import하지 않는다(9번)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tide-dashboard/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/tide-site/**", "tide-site"],
                "message": "앱끼리 import하지 않는다. 함께 쓰면 packages로 승격한다(9번)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tide-site/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/tide-dashboard/**", "tide-dashboard"],
                "message": "앱끼리 import하지 않는다. 함께 쓰면 packages로 승격한다(9번)."
              }
            ]
          }
        ]
      }
    }
  ]
}
